{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Releaseway distribution configuration",
  "oneOf": [{"$ref":"#/$defs/inputMappings"},{"$ref":"#/$defs/inputReleaseSet"}],
  "$defs": {
    "filename": {"type":"string","minLength":1},
    "inputFile": {"oneOf":[{"$ref":"#/$defs/filename"},{"$ref":"#/$defs/mapping"}]},
    "inputFiles": {"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/inputFile"}},
    "inputMappings": {
      "type":"object","additionalProperties":false,"required":["files"],
      "properties":{"schema":{"const":1},"files":{"$ref":"#/$defs/inputFiles"}}
    },
    "inputAliases": {
      "type":"object","additionalProperties":false,"required":["files"],
      "properties":{"tag":{"type":"string","minLength":1},"select":{"const":"highest-stable"},"files":{"$ref":"#/$defs/inputFiles"}},
      "oneOf":[{"required":["tag"],"not":{"required":["select"]}},{"required":["select"],"not":{"required":["tag"]}}]
    },
    "inputReleaseSet": {
      "type":"object","additionalProperties":false,"required":["releases","files"],
      "properties":{
        "schema":{"const":2},"releases":{"$ref":"#/$defs/selector"},"aliases":{"$ref":"#/$defs/inputAliases"},
        "files":{"type":"array","minItems":1,"maxItems":10000,
          "items":{"oneOf":[{"$ref":"#/$defs/filename"},{"$ref":"#/$defs/releaseFile"}]},
          "contains":{"oneOf":[{"$ref":"#/$defs/filename"},{"type":"object","not":{"properties":{"required":{"const":false}},"required":["required"]}}]}}
      },
      "description":"releases selects release-set mode. Paths, SemVer, collisions and alias references are also checked at runtime. Versioned object-only definitions below preserve the report policy contract."
    },
    "mapping": {
      "type":"object", "additionalProperties":false, "required":["from","to"],
      "properties":{"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1}}
    },
    "mappings": {"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/mapping"}},
    "v1": {
      "type":"object","additionalProperties":false,"required":["schema","files"],
      "properties":{"schema":{"const":1},"files":{"$ref":"#/$defs/mappings"}}
    },
    "onEmpty": {"enum":["error","skip"],"default":"error"},
    "selector": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["tags"],
         "properties":{"tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"on-empty":{"$ref":"#/$defs/onEmpty"}}},
        {"type":"object","additionalProperties":false,"required":["tag-prefix","range"],
         "properties":{"tag-prefix":{"type":"string"},"range":{"type":"string","minLength":1},"include-prereleases":{"type":"boolean","default":false},"on-empty":{"$ref":"#/$defs/onEmpty"}}}
      ]
    },
    "releaseFile": {
      "type":"object","additionalProperties":false,"required":["from","to"],
      "properties":{"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"required":{"type":"boolean","default":true}}
    },
    "aliases": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["tag","files"],
         "properties":{"tag":{"type":"string","minLength":1},"files":{"$ref":"#/$defs/mappings"}}},
        {"type":"object","additionalProperties":false,"required":["select","files"],
         "properties":{"select":{"const":"highest-stable"},"files":{"$ref":"#/$defs/mappings"}}}
      ]
    },
    "v2": {
      "type":"object","additionalProperties":false,"required":["schema","releases","files"],
      "properties":{
        "schema":{"const":2},"releases":{"$ref":"#/$defs/selector"},"aliases":{"$ref":"#/$defs/aliases"},
        "files":{"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/releaseFile"},
          "contains":{"type":"object","not":{"properties":{"required":{"const":false}},"required":["required"]}}}
      },
      "description":"Portable paths, SemVer syntax, duplicate targets and alias references are additionally checked at runtime. Alias select requires a range selector."
    }
  }
}
